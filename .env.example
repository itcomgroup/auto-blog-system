# Конфигурация Auto Blog System

# Claude API
ANTHROPIC_API_KEY=your_claude_api_key_here

# Exa API (для research)
EXA_API_KEY=your_exa_api_key_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=@your_channel_name

# Пути
CLAUDE_LOGS_DIR=~/.claude/logs
OUTPUT_DIR=./output
WEBSITE_CONTENT_DIR=./website/src/content/blog

# Настройки генерации
DEFAULT_LANGUAGE=ru
MAX_EXA_RESULTS=5
DEAIFY_ITERATIONS=2
MIN_COMPLEXITY=3

# Настройки сайта
SITE_URL=https://yourblog.com
SITE_TITLE=Мой Автоблог
SITE_DESCRIPTION=Блог о программировании и AI
AUTHOR_NAME=Ваше Имя
